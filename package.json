{
  "name": "server-monitoring-dashboard",
  "version": "1.0.0",
  "description": "A simple, production-ready server monitoring dashboard built with Node.js, Express, and vanilla JavaScript.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint src/ tests/"
  },
  "keywords": [
    "server",
